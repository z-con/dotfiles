#!/bin/bash
BLOCKED="$HOME/.config/omarchy/blocked-webapps"

[[ -f "$BLOCKED" ]] || exit 0

while IFS= read -r app; do
  [[ -z "$app" ]] && continue
  rm -f \
    "$HOME/.local/share/applications/${app}.desktop" \
    "$HOME/.local/share/applications/icons/${app}.png" \
    "$HOME/.local/share/applications/icons/${app}.svg"
done < "$BLOCKED"
